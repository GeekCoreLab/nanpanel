            <groupId>io.nanpanel</groupId>
            <artifactId>panel-network</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.nanpanel</groupId>
            <artifactId>panel-cluster</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.nanpanel</groupId>
