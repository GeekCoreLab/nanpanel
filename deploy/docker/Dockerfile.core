FROM docker.io/library/maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY . .
RUN ./mvnw -B -ntp -pl backend/panel-core,plugins/provider-netbird,plugins/provider-frp,plugins/provider-kubeedge -am package -DskipTests

FROM docker.io/library/rust:1.89-bookworm AS agent-build
ARG NANPANEL_BUILD_VERSION=development
ENV NANPANEL_BUILD_VERSION=${NANPANEL_BUILD_VERSION}
RUN apt-get update && apt-get install -y --no-install-recommends musl-tools protobuf-compiler \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add x86_64-unknown-linux-musl
WORKDIR /workspace
COPY agent/ ./agent/
RUN cargo build --locked --release --target x86_64-unknown-linux-musl \
    --manifest-path agent/Cargo.toml -p nanpanel-agent
RUN cargo build --locked --release --target x86_64-unknown-linux-musl \
    --manifest-path agent/Cargo.toml -p nanpanel-privileged-helper --bin nanpanel-helper

FROM docker.io/library/eclipse-temurin:21-jre-jammy
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
LABEL org.opencontainers.image.source="https://github.com/GeekCoreLab/nanpanel"
COPY --from=build --chown=10001:0 /workspace/backend/panel-core/target/quarkus-app/lib/ ./lib/
COPY --from=build --chown=10001:0 /workspace/backend/panel-core/target/quarkus-app/*.jar ./
COPY --from=build --chown=10001:0 /workspace/backend/panel-core/target/quarkus-app/app/ ./app/
COPY --from=build --chown=10001:0 /workspace/backend/panel-core/target/quarkus-app/quarkus/ ./quarkus/
COPY --from=build --chown=10001:0 /workspace/backend/panel-core/target/quarkus-app/quarkus-app-dependencies.txt ./
COPY --from=build --chown=10001:0 /workspace/plugins/provider-netbird/target/provider-netbird-*.jar ./providers/
COPY --from=build --chown=10001:0 /workspace/plugins/provider-frp/target/provider-frp-*.jar ./providers/
COPY --from=build --chown=10001:0 /workspace/plugins/provider-kubeedge/target/provider-kubeedge-*.jar ./providers/
COPY --from=agent-build --chown=10001:0 /workspace/agent/target/x86_64-unknown-linux-musl/release/nanpanel-agent ./nanpanel-agent
COPY --from=agent-build --chown=10001:0 /workspace/agent/target/x86_64-unknown-linux-musl/release/nanpanel-helper ./nanpanel-helper
COPY web/public/agent-install.sh ./agent-install.sh
ENV QUARKUS_HTTP_HOST=0.0.0.0
EXPOSE 8080 50051
USER 10001:0
ENTRYPOINT ["java", "-jar", "quarkus-run.jar"]
