FROM docker.io/library/rust:1.89-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY agent/ ./agent/
RUN cargo build --locked --release --manifest-path agent/Cargo.toml -p nanpanel-control-relay

FROM docker.io/library/debian:bookworm-slim
RUN groupadd --gid 10001 nanpanel-relay \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin nanpanel-relay \
    && install -d -o 10001 -g 10001 -m 0700 /var/lib/nanpanel-relay
WORKDIR /work
COPY --from=build --chown=10001:10001 /workspace/agent/target/release/nanpanel-control-relay ./nanpanel-control-relay
USER 10001:10001
EXPOSE 50053
ENTRYPOINT ["/work/nanpanel-control-relay"]
