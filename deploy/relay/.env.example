NANPANEL_RELAY_ID=relay-a
NANPANEL_RELAY_CLUSTER_ID=replace-with-stable-cluster-id
NANPANEL_RELAY_CORE_CERT_FINGERPRINTS=replace-with-lowercase-sha256-certificate-fingerprint
NANPANEL_RELAY_LISTEN=0.0.0.0:50053
NANPANEL_RELAY_STATE_DIRECTORY=/var/lib/nanpanel-relay
NANPANEL_RELAY_CLIENT_CA=/run/nanpanel-relay/certs/client-ca.pem
NANPANEL_RELAY_CERT=/run/nanpanel-relay/certs/relay-cert.pem
NANPANEL_RELAY_KEY=/run/nanpanel-relay/certs/relay-key.pem
