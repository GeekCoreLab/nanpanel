# Copy to .env and supply your own values; never commit .env.
DB_USER=nanpanel
DB_PASSWORD=
NANPANEL_ADMIN_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/nanpanel

# Public same-origin HTTPS address (production cookies require HTTPS)
NANPANEL_ORIGIN=https://localhost

# Optional Relay discovery/DNS coordination. DNS writes stay disabled by default.
NANPANEL_GATEWAY_CLUSTER_ID=nanpanel-main
NANPANEL_GATEWAY_LEASE_SECONDS=45
NANPANEL_AGENT_RELAY_ENDPOINTS=disabled
# Optional signed fallback list. Generate an Ed25519 PKCS#8 PEM key and keep it root-only.
NANPANEL_AGENT_RELAY_FALLBACK_ENDPOINTS=disabled
NANPANEL_AGENT_RELAY_SIGNING_PRIVATE_KEY=disabled
NANPANEL_AGENT_RELAY_SIGNING_PUBLIC_KEY=disabled
NANPANEL_DNS_ENABLED=false
# Use a Cloudflare API token restricted to DNS:Edit on only the configured Zone.
NANPANEL_CLOUDFLARE_DNS_TOKEN=disabled
NANPANEL_CLOUDFLARE_ZONE_ID=disabled
NANPANEL_CLOUDFLARE_ZONE_NAME=example.com
NANPANEL_DNS_MANAGED_SUFFIX=nanpanel.example.com
